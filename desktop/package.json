{
  "name": "appblocker-desktop",
  "productName": "AppBlocker",
  "version": "1.7.0",
  "description": "Block distracting apps and websites on Windows and macOS.",
  "main": "src/main/main.js",
  "author": "Rick",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.activeviewpoint.appblocker",
    "productName": "AppBlocker",
    "copyright": "Copyright © 2026 Active Viewpoint",
    "asar": false,
    "files": [
      "src/**/*",
      "!**/*.md",
      "!dev-unforce.cmd",
      "!build-installer.cmd",
      "!uninstall-dev.cmd"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AppBlocker",
      "menuCategory": false,
      "uninstallDisplayName": "AppBlocker",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "artifactName": "AppBlocker-Setup-${version}.${ext}",
      "include": "build/installer.nsh"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity"
    }
  }
}
