<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0A0A12"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <ImageView
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginBottom="20dp"
        android:src="@drawable/ic_lock_closed_big" />

    <TextView
        android:id="@+id/guardTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Getting your blocks ready"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/guardText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="Your phone just restarted. AppBlocker is switching your blocks back on - this only takes a moment."
        android:textColor="#9A9AA8"
        android:textSize="15sp" />

    <ProgressBar
        android:id="@+id/guardProgress"
        style="?android:attr/progressBarStyle"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="28dp"
        android:indeterminateTint="#3E7BFA" />

    <TextView
        android:id="@+id/guardCountdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="#3E7BFA"
        android:textSize="15sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/guardSettingsButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:backgroundTint="#3E7BFA"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:text="Open Accessibility settings"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:visibility="gone" />

</LinearLayout>
